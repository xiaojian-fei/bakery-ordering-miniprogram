<!-- pages/cart/cart.wxml -->
<view wx:if="{{!unifiedMode}}" class="cart-container">
  <view class="delivery-options">
    <text>配送方式：</text>
    <radio-group bindchange="onDeliveryTypeChange">
      <label><radio value="pickup" checked="{{deliveryType === 'pickup'}}" /> 自取</label>
      <label><radio value="delivery" checked="{{deliveryType === 'delivery'}}" /> 配送</label>
    </radio-group>
  </view>

  <view wx:if="{{deliveryType === 'delivery'}}" class="address-select" bindtap="selectAddress">
    <text>收货地址：{{selectedAddress ? (selectedAddress.province + selectedAddress.city + selectedAddress.district + selectedAddress.detail) : '请选择地址'}}</text>
    <text class="arrow">></text>
  </view>

  <view class="cart-list">
    <block wx:for="{{cartItems}}" wx:key="productId">
      <view class="cart-item">
        <view class="cart-emoji">{{item.emoji}}</view>
        <view class="cart-info">
          <text>{{item.name}}</text>
          <text>¥{{item.price}}</text>
        </view>
        <view class="quantity-control">
          <button size="mini" bindtap="changeQuantity" data-id="{{item.productId}}" data-op="minus">-</button>
          <text>{{item.quantity}}</text>
          <button size="mini" bindtap="changeQuantity" data-id="{{item.productId}}" data-op="plus">+</button>
        </view>
      </view>
    </block>
    <view wx:if="{{cartItems.length === 0}}" class="empty-cart">购物车空空如也～</view>
  </view>

  <view class="total-bar">
    <text>总计：¥{{totalPrice}}</text>
    <button type="primary" bindtap="goToOrder">去下单</button>
  </view>
</view>
<view wx:else class="cart-container">
  <view class="runtime-notice">{{runtimeNotice}}</view>
  <button size="mini" bindtap="openAddresses">查看收货地址</button>
  <view class="delivery-options">
    <text>配送方式：</text>
    <radio-group bindchange="onDeliveryTypeChange">
      <label><radio value="pickup" checked="{{deliveryType === 'pickup'}}" /> 自取</label>
      <label><radio value="delivery" checked="{{deliveryType === 'delivery'}}" /> 配送</label>
    </radio-group>
  </view>
  <view wx:if="{{deliveryType === 'delivery'}}" class="address-select" bindtap="openAddressPicker">
    <view><text>收货地址：{{selectedAddress ? selectedAddress.name + ' ' + selectedAddress.phone : '请选择地址'}}</text>
      <view wx:if="{{selectedAddress}}">{{selectedAddress.province}}{{selectedAddress.city}}{{selectedAddress.district}}{{selectedAddress.detail}}</view>
      <text wx:if="{{addressLoading}}">正在核对地址…</text>
    </view><text class="arrow">></text>
  </view>
  <view wx:if="{{addressError}}" class="runtime-error">{{addressError}}
    <button size="mini" bindtap="refreshSelectedAddress">重试核对</button>
  </view>
  <view wx:if="{{error}}" class="runtime-error">{{error}}<button size="mini" bindtap="loadCart">重试加载</button></view>
  <view wx:if="{{loading}}">加载中…</view>
  <view wx:if="{{cartWritePending}}" class="runtime-error">上次修改结果待确认
    <button size="mini" bindtap="retryCartWrite" disabled="{{cartBusy || loading}}">重试上次修改</button>
  </view>
  <view class="cart-list">
    <view wx:for="{{cartItems}}" wx:key="productId" class="cart-item">
      <view class="cart-emoji">{{item.emoji}}</view>
      <view class="cart-info"><text>{{item.name}}</text><text>¥{{item.price}}</text>
        <text wx:if="{{item.issue}}" class="runtime-error">{{item.issueText}}</text>
      </view>
      <view class="quantity-control">
        <button size="mini" bindtap="changeQuantity" data-id="{{item.productId}}" data-op="minus" disabled="{{cartBusy || loading || cartWritePending}}">-</button>
        <text>{{item.quantity}}</text>
        <button size="mini" bindtap="changeQuantity" data-id="{{item.productId}}" data-op="plus" disabled="{{cartBusy || loading || cartWritePending || item.quantity >= 99 || item.issue}}">+</button>
      </view>
    </view>
    <view wx:if="{{!loading && !error && cartItems.length === 0}}" class="empty-cart">购物车空空如也～</view>
  </view>
  <view wx:if="{{quoteError}}" class="runtime-error">{{quoteError}}
    <button size="mini" bindtap="goToOrder" disabled="{{loading || cartBusy || cartWritePending || addressLoading || quoteLoading}}">重新报价</button>
    <button size="mini" bindtap="loadCart" disabled="{{loading || cartBusy}}">刷新购物车</button>
  </view>
  <view wx:if="{{checkoutQuote}}" class="quote-preview">
    <view class="quote-title">结算报价预览</view>
    <view>{{checkoutQuote.deliveryType === 'pickup' ? '到店自取' : '配送到家'}}</view>
    <view wx:if="{{checkoutQuote.address}}">{{checkoutQuote.address.name}} {{checkoutQuote.address.phone}}
      <view>{{checkoutQuote.address.province}}{{checkoutQuote.address.city}}{{checkoutQuote.address.district}}{{checkoutQuote.address.detail}}</view>
    </view>
    <view wx:for="{{checkoutQuote.items}}" wx:key="productId" class="quote-row">
      <text>{{item.name}} × {{item.quantity}}（¥{{item.price}}/件）</text><text>¥{{item.total}}</text>
    </view>
    <view class="quote-row"><text>商品金额</text><text>¥{{checkoutQuote.subtotal}}</text></view>
    <view class="quote-row"><text>运费</text><text>¥{{checkoutQuote.shipping}}</text></view>
    <view class="quote-row quote-title"><text>合计</text><text>¥{{checkoutQuote.total}}</text></view>
    <view class="quote-note">报价未锁定价格或库存，尚未创建订单。下单时将重新核对。</view>
  </view>
  <view class="total-bar"><text>商品估算：¥{{totalPrice}}（不含运费）</text>
    <button bindtap="goToOrder" loading="{{quoteLoading}}" disabled="{{loading || cartBusy || cartWritePending || addressLoading || quoteLoading || !canCheckout}}">预览结算</button>
  </view>
</view>
<custom-tab-bar />
