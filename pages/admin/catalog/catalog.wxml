<view class="catalog">
  <input placeholder="搜索商品名称" maxlength="60" value="{{keyword}}" bindinput="enterKeyword" bindconfirm="searchProducts" />
  <button size="mini" bindtap="searchProducts" disabled="{{busy}}">搜索</button>
  <button size="mini" bindtap="refreshProducts" disabled="{{loading || busy}}">刷新</button>
  <button size="mini" bindtap="newProduct" disabled="{{busy || pending}}">新增商品</button>
  <view wx:if="{{error}}" class="runtime-error">{{error}}</view>
  <view wx:if="{{notice}}">{{notice}}</view>
  <button wx:if="{{pending}}" bindtap="retryProduct" disabled="{{busy}}">重试原操作</button>
  <view wx:if="{{editing}}" class="catalog-card">
    <view>{{editing.type === 'stock' ? '调整实物库存' : (editing.row ? '编辑商品' : '新增商品')}}</view>
    <block wx:if="{{editing.type === 'stock'}}">
      <view>实物 {{editing.row.onHand}} · 已预留 {{editing.row.reserved}} · 可售 {{editing.row.available}}</view>
      <input type="number" placeholder="目标实物库存" value="{{form.onHand}}" data-key="onHand" bindinput="editProductField" disabled="{{busy}}" />
      <textarea placeholder="调整原因" maxlength="200" value="{{form.reason}}" data-key="reason" bindinput="editProductField" disabled="{{busy}}" />
    </block>
    <block wx:else>
      <input placeholder="商品名称" maxlength="100" value="{{form.name}}" data-key="name" bindinput="editProductField" disabled="{{busy}}" />
      <input type="digit" placeholder="价格（元）" value="{{form.price}}" data-key="price" bindinput="editProductField" disabled="{{busy}}" />
      <input placeholder="商品分类" maxlength="60" value="{{form.category}}" data-key="category" bindinput="editProductField" disabled="{{busy}}" />
      <input placeholder="商品图片地址（可选）" maxlength="1000" value="{{form.image}}" data-key="image" bindinput="editProductField" disabled="{{busy}}" />
      <textarea placeholder="商品描述" maxlength="1000" value="{{form.desc}}" data-key="desc" bindinput="editProductField" disabled="{{busy}}" />
      <view>上架 <switch checked="{{form.isOnSale}}" data-key="isOnSale" bindchange="editProductField" disabled="{{busy}}" /></view>
      <view>推荐 <switch checked="{{form.isFeatured}}" data-key="isFeatured" bindchange="editProductField" disabled="{{busy}}" /></view>
      <view wx:if="{{!editing.row}}">新商品初始库存为零，保存后可单独调整。</view>
    </block>
    <button size="mini" type="primary" bindtap="submitProduct" disabled="{{busy || pending}}" loading="{{busy}}">保存</button>
    <button size="mini" bindtap="closeProductForm" disabled="{{busy}}">关闭</button>
  </view>
  <view wx:if="{{loading}}">正在加载…</view>
  <view wx:if="{{!loading && !error && !rows.length}}">暂无商品</view>
  <view wx:for="{{rows}}" wx:key="_id" class="catalog-card">
    <view>{{item.name}} · ¥{{item.price}} · {{item.isOnSale ? '已上架' : '已下架'}}</view>
    <view>实物 {{item.onHand}} · 已预留 {{item.reserved}} · 可售 {{item.available}}</view>
    <button size="mini" data-id="{{item._id}}" data-type="catalog" bindtap="editProduct" disabled="{{busy || pending}}">编辑商品</button>
    <button size="mini" data-id="{{item._id}}" data-type="stock" bindtap="editProduct" disabled="{{busy || pending}}">调整库存</button>
  </view>
  <button wx:if="{{cursor}}" bindtap="moreProducts" disabled="{{busy || loading}}">加载更多</button>
</view>
