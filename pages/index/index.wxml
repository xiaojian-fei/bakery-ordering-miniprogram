<!-- pages/index/index.wxml -->
<view class="container">
  <view wx:if="{{unifiedMode}}" class="runtime-notice">{{runtimeNotice}}</view>
  <view wx:if="{{unifiedMode}}" class="catalog-search">
    <input value="{{keyword}}" maxlength="60" placeholder="搜索商品名称" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
    <button size="mini" bindtap="onSearchConfirm">搜索</button>
  </view>
  <view wx:if="{{unifiedMode && cartWritePending}}" class="runtime-error">上次购物车修改结果待确认
    <button size="mini" bindtap="retryCartWrite" disabled="{{cartBusy}}">重试上次修改</button>
  </view>
 <!-- 轮播图 -->
<swiper wx:if="{{banners.length > 0}}" class="swiper" indicator-dots autoplay circular interval="3000" duration="500">
  <block wx:for="{{banners}}" wx:key="index">
    <swiper-item>
      <image src="{{item}}" mode="aspectFill" class="swiper-image"></image>
    </swiper-item>
  </block>
</swiper>
  <!-- 商家信息卡片 -->
  <view class="shop-info-card">
    <view class="shop-title">
      <text class="shop-icon">🏪</text>
      <text>店铺信息</text>
      <!-- 审核期间隐藏管理按钮 -->
       <text class="admin-btn" bindtap="goToAdmin">🔧 管理</text> 
    </view>
    <view class="info-item">
      <text class="label">📍 地址：</text>
      <text class="value">{{shopInfo.address}}</text>
    </view>
    <!-- 微信：分行显示 -->
    <view class="info-item" wx:if="{{shopInfo.wechatList && (shopInfo.wechatList[0] || shopInfo.wechatList[1])}}">
      <text class="label">💬 微信：</text>
      <view class="value">
        <view wx:if="{{shopInfo.wechatList[0]}}" class="wechat-item" data-wechat="{{shopInfo.wechatList[0]}}" bindtap="copyWechat">{{shopInfo.wechatList[0]}} <text class="copy-hint">点击复制</text></view>
        <view wx:if="{{shopInfo.wechatList[1]}}" class="wechat-item" data-wechat="{{shopInfo.wechatList[1]}}" bindtap="copyWechat">{{shopInfo.wechatList[1]}} <text class="copy-hint">点击复制</text></view>
      </view>
    </view>
    <!-- 电话：分行显示 -->
    <view class="info-item" wx:if="{{shopInfo.phoneList && (shopInfo.phoneList[0] || shopInfo.phoneList[1])}}">
      <text class="label">📞 电话：</text>
      <view class="value">
        <view wx:if="{{shopInfo.phoneList[0]}}" class="phone-item" data-phone="{{shopInfo.phoneList[0]}}" bindtap="makePhoneCall">{{shopInfo.phoneList[0]}}</view>
        <view wx:if="{{shopInfo.phoneList[1]}}" class="phone-item" data-phone="{{shopInfo.phoneList[1]}}" bindtap="makePhoneCall">{{shopInfo.phoneList[1]}}</view>
      </view>
    </view>
    <!-- 配送时间：分行显示 -->
    <view class="info-item" wx:if="{{shopInfo.deliveryTimeList && (shopInfo.deliveryTimeList[0] || shopInfo.deliveryTimeList[1] || shopInfo.deliveryTimeList[2])}}">
      <text class="label">⏰ 配送时间：</text>
      <view class="value">
        <view wx:if="{{shopInfo.deliveryTimeList[0]}}" class="time-item">{{shopInfo.deliveryTimeList[0]}}</view>
        <view wx:if="{{shopInfo.deliveryTimeList[1]}}" class="time-item">{{shopInfo.deliveryTimeList[1]}}</view>
        <view wx:if="{{shopInfo.deliveryTimeList[2]}}" class="time-item">{{shopInfo.deliveryTimeList[2]}}</view>
      </view>
    </view>
  </view>

  <!-- 分类切换栏 -->
  <view class="category-bar">
    <view wx:for="{{categories}}" wx:key="index" class="category-item {{currentCategory === item ? 'active' : ''}}" bindtap="onCategoryChange" data-category="{{item}}">
      {{item}}
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="product-list">
    <block wx:for="{{products}}" wx:key="_id">
      <view class="product-card">
        <view class="product-image">
          <image wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:else class="product-emoji">{{item.emoji}}</view>
        </view>
        <view class="product-info">
          <view class="product-name-row">
            <text class="product-name">{{item.name}}</text>
            <text wx:if="{{item.isFeatured}}" class="featured-tag">🔥 招牌</text>
          </view>
          <view wx:if="{{!unifiedMode}}" class="product-sales">月销 {{item.monthSales || 0}} 件</view>
          <view wx:else class="product-sales">可售 {{item.available}} 件</view>
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-desc">{{item.desc}}</text>
          <view class="actions">
            <button size="mini" type="default" bindtap="goDetail" data-id="{{item._id}}">详情</button>
            <button size="mini" type="primary" bindtap="addToCart" data-id="{{item._id}}" data-item="{{item}}" disabled="{{unifiedMode && (cartBusy || cartWritePending || item.available < 1)}}">加入购物车</button>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{loading}}" class="empty-tip">加载中…</view>
    <view wx:if="{{error}}" class="runtime-error">{{error}}<button size="mini" bindtap="onSearchConfirm">重试加载</button></view>
    <view wx:if="{{!loading && !error && products.length === 0}}" class="empty-tip">暂无商品</view>
    <button wx:if="{{unifiedMode && cursor}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
  </view>
</view>
<custom-tab-bar />
